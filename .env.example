# Contact-form lead alerts — see lib/email.ts and lib/whatsapp.ts.
# Copy to .env.local (never committed) and fill in. A channel whose settings
# are missing runs in dry-run mode and prints the alert to the server log.

# Email via Resend (resend.com → API Keys, "Sending access").
RESEND_API_KEY=
# Until a domain is verified in Resend, must be the Resend account's own email.
LEAD_EMAIL_TO=marabuconstructions@gmail.com
# Optional, once a domain is verified: LEAD_EMAIL_FROM="Marabu Website <leads@your-domain>"

# WhatsApp via the Meta WhatsApp Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=918489055666
# "hello_world" to test the connection; "new_lead_alert" once that template is approved.
WHATSAPP_TEMPLATE=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
# Graph API version from the sample request on WhatsApp → API Setup.
WHATSAPP_API_VERSION=v27.0
