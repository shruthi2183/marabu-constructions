# Contact-form WhatsApp alerts (Meta WhatsApp Cloud API) — see lib/whatsapp.ts.
# Copy to .env.local (never committed) and fill in. With TOKEN, PHONE_NUMBER_ID
# or TO missing, the form runs in dry-run mode and prints alerts to the server log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=918489055666
# "hello_world" to test the connection; "new_lead_alert" once that template is approved.
WHATSAPP_TEMPLATE=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
# Graph API version from the sample request on WhatsApp → API Setup.
WHATSAPP_API_VERSION=v23.0
